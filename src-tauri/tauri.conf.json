{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syrion Cut",
  "version": "1.0.0",
  "identifier": "com.meor.syrioncut",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Syrion Cut — Background Remover",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*.png", "**/*.PNG", "**/*.jpg", "**/*.JPG", "**/*.jpeg", "**/*.JPEG", "**/*.webp", "**/*.WEBP", "**/*.bmp", "**/*.BMP"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/birefnet.onnx": "resources/birefnet.onnx",
      "resources/real_esrgan_x4plus.onnx": "resources/real_esrgan_x4plus.onnx",
      "resources/real_esrgan_x4plus.data": "resources/real_esrgan_x4plus.data",
      "bin/DirectML.dll": "DirectML.dll"
    }
  }
}
